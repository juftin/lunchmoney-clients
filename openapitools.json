{
    "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
    "spaces": 2,
    "generator-cli": {
        "version": "7.17.0",
        "generators": {
            "python": {
                "inputSpec": "openapi.yaml",
                "output": "clients/python",
                "generatorName": "python",
                "gitUserId": "juftin",
                "gitRepoId": "lunchmoney-clients",
                "library": "urllib3",
                "additionalProperties": {
                    "packageVersion": "2.18.1",
                    "packageName": "lunchmoney",
                    "projectName": "lunchmoney-python"
                },
                "openapi-normalizer": {
                    "REMOVE_X_INTERNAL": true
                }
            },
            "python-async": {
                "inputSpec": "openapi.yaml",
                "output": "clients/python-async",
                "generatorName": "python",
                "gitUserId": "juftin",
                "gitRepoId": "lunchmoney-clients",
                "library": "httpx",
                "additionalProperties": {
                    "packageVersion": "2.18.1",
                    "packageName": "lunchmoney",
                    "projectName": "lunchmoney-python-async"
                },
                "openapi-normalizer": {
                    "REMOVE_X_INTERNAL": true
                }
            },
            "go": {
                "inputSpec": "openapi.yaml",
                "output": "clients/go",
                "generatorName": "go",
                "gitUserId": "juftin",
                "gitRepoId": "lunchmoney-clients",
                "packageName": "lunchmoney",
                "additionalProperties": {
                    "packageVersion": "2.18.1"
                },
                "openapi-normalizer": {
                    "REMOVE_X_INTERNAL": true
                }
            }
        }
    }
}
